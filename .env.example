# ============================================================
# SQLI WORKSHOP SANDBOX
# Variables de ejemplo para el entorno local educativo
# ============================================================

COMPOSE_PROJECT_NAME=sqli-workshop

# Puertos publicados en el equipo local
FRONTEND_PORT=3000
BACKEND_PORT=8080
WAF_PORT=8082

# Base de datos administrativa del escáner
SCANNER_DB_HOST=scanner-db
SCANNER_DB_PORT=3306
SCANNER_DB_NAME=scanner_db
SCANNER_DB_USER=scanner_user
SCANNER_DB_PASSWORD=scanner_password
SCANNER_DB_ROOT_PASSWORD=scanner_root_password

# Base de datos aislada del laboratorio
LAB_DB_HOST=lab-db
LAB_DB_PORT=3306
LAB_DB_NAME=workshop_db
LAB_DB_USER=workshop_user
LAB_DB_PASSWORD=workshop_password
LAB_DB_ROOT_PASSWORD=workshop_root_password

# Configuración interna del backend
BACKEND_PORT_INTERNAL=8080
GIN_MODE=release

# Objetivos autorizados dentro del sandbox
ALLOWED_TARGETS=vulnerable-app,secure-app,waf

# Configuración interna de la aplicación educativa
LAB_APP_PORT=8081
LAB_MODE=vulnerable