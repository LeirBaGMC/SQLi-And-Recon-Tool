# ============================================================
# SQLI WORKSHOP SANDBOX
# Variables de ejemplo para el entorno local educativo
# ============================================================

COMPOSE_PROJECT_NAME=sqli-workshop

# Puertos publicados en el equipo local
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Base de datos administrativa del escáner
SCANNER_DB_HOST=scanner-db
SCANNER_DB_PORT=3306
SCANNER_DB_NAME=scanner_db
SCANNER_DB_USER=scanner_user
SCANNER_DB_PASSWORD=scanner_password
SCANNER_DB_ROOT_PASSWORD=scanner_root_password

# Configuración interna del backend
GIN_MODE=release

# DVWA local (cuenta de entrenamiento)
DVWA_PORT=8000
DVWA_USERNAME=admin
DVWA_PASSWORD=password
DVWA_DB_PASSWORD=dvwa_local_password
DVWA_DB_ROOT_PASSWORD=dvwa_local_root_password
